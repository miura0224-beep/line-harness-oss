{
  "name": "line-harness-oss",
  "version": "0.1.0",
  "description": "LINE Messaging API harness on Cloudflare Workers + D1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply line-harness --local",
    "db:migrate:prod": "wrangler d1 migrations apply line-harness --remote",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "hono": "^4.12.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260811.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.4.0"
  }
}
